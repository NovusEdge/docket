#!/usr/bin/env python3
"""Append-only decision ledger. Standard library only, because a SessionStart
hook runs this on every session and cannot wait on a dependency install."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

STATES = ("settled", "ruled-out", "open")
LEDGER = Path(".docket/ledger.jsonl")

# Honours XDG so the global store can be relocated, and CLAUDE_CONFIG_DIR so an
# isolated Claude profile gets its own ledgers.
def global_root() -> Path:
    if env := os.environ.get("DOCKET_HOME"):
        return Path(env).expanduser()
    if env := os.environ.get("CLAUDE_CONFIG_DIR"):
        return Path(env).expanduser() / "docket"
    return Path.home() / ".claude" / "docket"


def session_id() -> str:
    """Claude Code exposes this under more than one name across versions."""
    for var in ("CLAUDE_SESSION_ID", "CLAUDE_CODE_BRIDGE_SESSION_ID", "SESSION_ID"):
        if v := os.environ.get(var):
            return v
    return ""


def author() -> str:
    """Which agent or person recorded the entry.

    Two agents sharing one ledger is the normal case, so an entry that does not
    say who wrote it cannot be weighed.
    """
    if v := os.environ.get("DOCKET_AUTHOR"):
        return v
    if v := os.environ.get("AI_AGENT"):
        return v.split("_")[0]
    if os.environ.get("CODEX_SANDBOX") or os.environ.get("CODEX_HOME"):
        return "codex"
    return os.environ.get("USER", "")


def resolved_author() -> str:
    """author(), falling back to a visible "unknown" instead of silence.

    A blank string is indistinguishable from an unset field once serialized, so
    a caller reading the ledger cannot tell "detection failed" from "this entry
    predates the author field". Writing "unknown" makes the failure visible;
    the missing key on old entries stays the only true absence.
    """
    a = author()
    if a:
        return a
    print(
        "docket: could not detect an author; recording \"unknown\". "
        "Set DOCKET_AUTHOR to identify this harness.",
        file=sys.stderr,
    )
    return "unknown"


def branch(root: Path) -> str:
    """Current branch, or empty outside a repository.

    Uses `branch --show-current` because `rev-parse --abbrev-ref HEAD` fails on
    an unborn branch, which is every repository before its first commit.
    """
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "branch", "--show-current"],
            capture_output=True, text=True, timeout=2,
        )
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def project_root(start: Path | None = None) -> Path:
    """The directory a project-local ledger belongs to.

    Prefers the git root so a subdirectory shares the project's ledger. Falls
    back to the working directory outside a repository.
    """
    here = (start or Path.cwd()).resolve()
    for d in (here, *here.parents):
        if (d / ".git").exists():
            return d
    return here


def slug(path: Path) -> str:
    """Mangle an absolute path into one filename component."""
    return str(path).replace("/", "-").replace("\\", "-").strip("-") or "root"


def ledger_path(start: Path | None = None) -> Path:
    """Resolve the ledger for the current project.

    A .docket directory in the project wins, which is how a team opts into
    committing decisions. Otherwise the ledger lives under the global root,
    keyed by project path, so a new project needs no setup and no gitignore
    entry.
    """
    here = (start or Path.cwd()).resolve()
    for d in (here, *here.parents):
        candidate = d / LEDGER
        if candidate.exists():
            return candidate
    return global_root() / slug(project_root(here)) / "ledger.jsonl"


def read(path: Path) -> list[dict]:
    if not path.exists():
        return []
    entries = []
    for n, line in enumerate(path.read_text().splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            print(f"docket: skipped malformed line {n}", file=sys.stderr)
    return entries


def next_id(entries: list[dict]) -> str:
    used = {e.get("id", "") for e in entries}
    n = len(entries) + 1
    while f"d{n}" in used:
        n += 1
    return f"d{n}"


def cmd_add(args: argparse.Namespace) -> int:
    path = ledger_path()
    entries = read(path)

    # Each --because is one conjunctive set; repeating the flag adds an
    # alternative. Stored as [["d1","d2"], ["d5"]], read as (d1 AND d2) OR d5.
    because = [
        [b.strip() for b in group.split(",") if b.strip()]
        for group in (args.because or [])
    ]
    because = [s for s in because if s]
    known = {e.get("id") for e in entries}
    unknown = [b for s in because for b in s if b not in known]
    if unknown:
        print(f"docket: unknown justification ids: {', '.join(unknown)}", file=sys.stderr)
        return 1

    entry = {
        "id": next_id(entries),
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "state": args.state,
        "question": args.question,
        "answer": args.answer,
        # Empty means atomic. Each inner list is a complete, independent
        # justification; the claim survives while any one of them survives.
        "because": because,
        "cost_if_wrong": args.cost or "",
        "session": session_id(),
        "author": resolved_author(),
        # Captured because the log is append-only. An entry written on a branch
        # can never learn afterwards which branch it came from.
        "branch": branch(project_root()),
    }

    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps(entry) + "\n")
    print(f"{entry['id']}  {entry['state']}  {entry['question']}")
    return 0


def justification_sets(e: dict) -> list[list[str]]:
    """because as alternative sets, reading a legacy flat list as one set.

    Every entry before this change stored because as a flat list of ids,
    which meant a single conjunctive set. That shape still reads as one set
    rather than one alternative per id, so old entries do not over-retract
    into needing every id independently.
    """
    b = e.get("because") or []
    if b and isinstance(b[0], str):
        return [b]
    return b


def _match(e: dict, term: str) -> bool:
    term = term.lower()
    return term in e.get("question", "").lower() or term in e.get("answer", "").lower()


def cmd_list(args: argparse.Namespace) -> int:
    entries = read(ledger_path())
    if args.state:
        entries = [e for e in entries if e.get("state") == args.state]
    if args.find:
        entries = [e for e in entries if _match(e, args.find)]
    if not entries:
        print("docket: nothing recorded")
        return 0
    for e in entries:
        sets = justification_sets(e)
        # " | " separates alternatives; each alternative's own ids stay comma-joined.
        dep = f"  <- {' | '.join(','.join(s) for s in sets)}" if sets else ""
        print(f"{e['id']:<5} {e['state']:<9} {e['question']}{dep}")
        print(f"      {e['answer']}")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    for e in read(ledger_path()):
        if e.get("id") == args.id:
            print(json.dumps(e, indent=2))
            return 0
    print(f"docket: no entry {args.id}", file=sys.stderr)
    return 1


def cmd_where(args: argparse.Namespace) -> int:
    path = ledger_path()
    kind = "project" if LEDGER.name in str(path) and ".claude" not in str(path) else "global"
    print(f"{path}  ({kind}, {'exists' if path.exists() else 'not created yet'})")
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    """Move this project's ledger into the repository so it can be committed."""
    root = project_root()
    target = root / LEDGER
    if target.exists():
        print(f"docket: already project-local at {target}")
        return 0

    existing = read(global_root() / slug(root) / "ledger.jsonl")
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open("w") as f:
        for e in existing:
            f.write(json.dumps(e) + "\n")
    moved = f", moved {len(existing)} entr{'y' if len(existing) == 1 else 'ies'}" if existing else ""
    print(f"docket: created {target}{moved}")
    return 0


def cmd_context(args: argparse.Namespace) -> int:
    """Print the ledger for injection at session start.

    Prints nothing when the ledger is empty, so a project without one costs no
    context.
    """
    entries = read(ledger_path())
    if not entries:
        return 0

    settled = [e for e in entries if e.get("state") == "settled"]
    ruled = [e for e in entries if e.get("state") == "ruled-out"]
    still_open = [e for e in entries if e.get("state") == "open"]

    me = Path(__file__).resolve()
    print("# docket: decisions already made in this project")
    print()
    print("Treat these as binding. To contradict one, say so explicitly and")
    print("record the reversal. Record decisions by running:")
    print()
    print(f"    {me} add \"question\" --answer \"...\"")
    print()
    for label, group in (("Settled", settled), ("Ruled out", ruled), ("Open", still_open)):
        if not group:
            continue
        print(f"## {label}")
        for e in group:
            print(f"- [{e['id']}] {e['question']} -> {e['answer']}")
            if e.get("cost_if_wrong"):
                print(f"  cost if wrong: {e['cost_if_wrong']}")
        print()
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="docket", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="record a decision")
    a.add_argument("question")
    a.add_argument("--state", choices=STATES, default="settled")
    a.add_argument("--answer", required=True)
    a.add_argument(
        "--because", action="append",
        help="comma-separated ids this depends on; repeat for an alternative support set",
    )
    a.add_argument("--cost", help="what breaks if this is later reversed")
    a.set_defaults(func=cmd_add)

    ls = sub.add_parser("list", help="list decisions")
    ls.add_argument("--state", choices=STATES)
    ls.add_argument("--find", help="match question or answer text")
    ls.set_defaults(func=cmd_list)

    sh = sub.add_parser("show", help="print one entry as JSON")
    sh.add_argument("id")
    sh.set_defaults(func=cmd_show)

    ctx = sub.add_parser("context", help="print the ledger for session injection")
    ctx.set_defaults(func=cmd_context)

    wh = sub.add_parser("where", help="print which ledger file is in use")
    wh.set_defaults(func=cmd_where)

    it = sub.add_parser("init", help="move this project's ledger into the repository")
    it.set_defaults(func=cmd_init)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
