# The ledger and the feature store merge through `docket merge-driver`, which
# appends the other side's new lines under fresh ids. Each clone registers the
# driver with `docket init`; without it git reports an ordinary conflict.
.docket/ledger.jsonl merge=docket
.docket/features.jsonl merge=docket
# Built from web/ by `just web-build`; CI checks it matches the source.
docket/web/dist/** -diff linguist-generated eol=lf
